{
  "name": "page-of-the-soul-poetry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "page_of_the__soul: three Hinglish poetry posts a day (two voice Reels, one carousel), verified public-domain Kabir/Rahim couplets, published on time by GitHub Actions; voice Reels made ahead on the Mac.",
  "scripts": {
    "generate": "node src/cli.js generate",
    "publish-next": "node src/cli.js publish-next",
    "rerender": "node src/cli.js rerender",
    "refresh-token": "node src/cli.js refresh-token",
    "tick": "node src/cli.js tick",
    "cron:setup": "node scripts/setup-cronjobs.js",
    "check-config": "node src/cli.js check-config",
    "history": "node src/cli.js history",
    "check": "for f in $(find src tests scripts -name '*.js'); do node --check $f || exit 1; done",
    "test": "node --test tests/*.test.js",
    "voice": "node scripts/voice-worker.mjs",
    "voice:install": "sh scripts/install-launchd.sh",
    "voice:remove": "sh scripts/install-launchd.sh --remove"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource/lora": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.64.1"
  }
}
