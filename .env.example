# Copy to .env and fill in. Never commit .env.

# ---- Writing (Google Gemini free tier, no card) ----------------------------------
# Key: https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
# Contact string sent to Wikisource in the User-Agent, as its API policy asks
BOT_CONTACT=

# ---- Content ------------------------------------------------------------------------
# Posts drafted per run (each in a different category)
POSTS_PER_RUN=3
BRAND_NAME=page_of_the__soul
TIMEZONE=Asia/Kolkata
JOB_MAX_ATTEMPTS=3

# ---- Instagram (official Graph API) — the ECHOES OF YESTERDAY account only -------------
# Do not reuse the Daily Fact Check credentials: posts would go to that account.
# Numeric ID (not the username): GET https://graph.instagram.com/v23.0/me?fields=user_id
INSTAGRAM_USER_ID_POETRY=
# graph.instagram.com → Instagram Login token (instagram_business_basic + instagram_business_content_publish)
# graph.facebook.com  → Facebook Login token (instagram_basic + instagram_content_publish)
INSTAGRAM_API_HOST=graph.instagram.com
# _POETRY names keep these apart from the Daily Fact Check INSTAGRAM_ACCESS_TOKEN / META_APP_SECRET
INSTAGRAM_ACCESS_TOKEN_POETRY=
# Only used with graph.facebook.com
META_APP_SECRET_POETRY=
GRAPH_API_VERSION=v23.0
# Master switch. false = drafts only. Set true only when you want posts to go live automatically.
PUBLISH_TO_INSTAGRAM=false

# ---- Public hosting for the slides (Instagram fetches media from a URL) ----------------
MEDIA_HOST=facebook
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
MEDIA_BRANCH=ig-media
MEDIA_RETENTION_DAYS=7

# ---- Paths / logging ---------------------------------------------------------------------
STATE_DIR=state
OUTPUT_DIR=output
LOG_DIR=logs
LOG_LEVEL=info
CHROMIUM_PATH=

# ---- cron-job.org triggers (local only: npm run cron:setup) ----------------------
# console.cron-job.org → Settings → API → Create API key
CRONJOB_ORG_API_KEY=
# Fine-grained GitHub token: only this repo, Repository permissions → Actions: Read and write
GH_DISPATCH_TOKEN=

# ---- Queue ---------------------------------------------------------------------------
# Drafts kept waiting (the Mac voices them ahead)
DRAFT_BUFFER=15
REELS_ENABLED=true

# ---- Mac voice worker (voice Reels) ----------------------------------------------------
# huggingface.co token (read), after accepting ai4bharat/IndicF5's terms
HF_TOKEN=
# unsplash.com/developers → your app → Access Key (real photos for the cinematic Reels)
UNSPLASH_ACCESS_KEY=
